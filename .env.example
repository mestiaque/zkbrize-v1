# ─────────────────────────────────────────────────────────────────
#  ZK Bridge — environment configuration
#
#  On first start the app copies this file to .env automatically and
#  fills in SESSION_SECRET and MASTER_PASSWORD with random values.
#  Edit .env (not this file) and restart the server to apply changes.
# ─────────────────────────────────────────────────────────────────

# ── Web server ───────────────────────────────────────────────────
# Port for the web UI and API (http://localhost:PORT)
PORT=3000

# ── Login ────────────────────────────────────────────────────────
# Built-in super admin account. Leave MASTER_PASSWORD empty to disable it.
MASTER_USERNAME=superadmin
MASTER_PASSWORD=

# Secret used to sign login sessions. Use a long random string.
SESSION_SECRET=

# ── ZKTeco devices ───────────────────────────────────────────────
# ADMS / Push port — set the same port in the device's Cloud Server settings
ADMS_PORT=5015

# TCP/IP (pull mode, port 4370) response timeout in milliseconds
ZK_TIMEOUT=5000

# ── ERP API ──────────────────────────────────────────────────────
# Base URL of your ERP API and its bearer token
LARAVEL_API_URL=
LARAVEL_API_TOKEN=

# Optional full URLs (override the base URL for each endpoint)
FETCH_EMPLOYEE_URL=
SYNC_ATTENDANCE_URL=

# ── Schedules (cron format) ──────────────────────────────────────
# Fetch employees from ERP and push them to devices
EMPLOYEE_SYNC_ENABLED=true
SYNC_SCHEDULE=*/30 * * * *

# Pull attendance from TCP devices and push all new records to ERP
ATTENDANCE_SYNC_ENABLED=true
ATTENDANCE_FETCH_SCHEDULE=*/15 * * * *

# ── Logging ──────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
